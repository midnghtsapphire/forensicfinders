# Optional secrets for cameras.ring_cam (Audrey's own Ring account). Never commit a filled-in copy.
# First login only. After that the token cache is used.
RING_USERNAME=
RING_PASSWORD=
# 2FA code if Ring asks for one (first login only)
RING_OTP=
# Token cache file (default ~/.config/forensicfinders/ring_token.json, written with mode 600)
RING_TOKEN_CACHE=
# Public camera sources (cameras/sources.json) need no keys.
