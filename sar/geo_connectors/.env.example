# geo_connectors needs no keys: Earth Search, CMR-STAC search, 3DEP, Wayback CDX and public
# ArcGIS layers are all open. Optional:
# NASA Earthdata token, needed only to DOWNLOAD protected HLS/LPCLOUD assets (search works without it).
EARTHDATA_TOKEN=
# Set to 1 to run live endpoint tests.
SAR_LIVE_TESTS=0
# Camera connectors (registry 1910): see cameras/.env.example.
